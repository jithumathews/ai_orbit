# AI ORBIT — Environment Secrets Template
# WARNING: NEVER commit real keys to git or embed in Flutter client code!
# Set these on Supabase via CLI:
#   supabase secrets set GROQ_API_KEY="gsk_..."
#   supabase secrets set OPENROUTER_API_KEY="sk-or-..."
#   supabase secrets set TOGETHER_API_KEY="..."

# Supabase Edge Functions Secrets
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Provider 1 (Primary high-speed LLM)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Provider 2 (Secondary fallback LLM)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Optional Provider 3 (Emergency fallback)
TOGETHER_API_KEY=your_together_api_key_here

# Client Flutter App Configuration (Public keys only)
# Can be supplied at build time via --dart-define:
# flutter run -d chrome --dart-define=SUPABASE_URL=https://your-project.supabase.co --dart-define=SUPABASE_ANON_KEY=eyJhbGci...
